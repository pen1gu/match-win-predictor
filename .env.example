DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/match_win_predictor
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/match_win_predictor
DATABASE_ECHO=false

HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3

DEFAULT_LEAGUES=ESP-La Liga
DEFAULT_SEASONS=2024/2025
SOFASCORE_DATA_DIR=.data/soccerdata

BACKFILL_LEAGUES=ESP-La Liga,ENG-Premier League,ITA-Serie A,GER-Bundesliga
BACKFILL_START_YEAR=2000
INGEST_STATE_PATH=.data/ingest_state.json
INGEST_DETAIL_DELAY_SEC=0.5
INGEST_FETCH_PLAYER_STATS=true

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
